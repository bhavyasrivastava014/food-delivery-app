# Backend Environment Variables
mongoURI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
PORT=5000
NODE_ENV=production
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_here
